# Azure OpenAI backend proxy configuration for server.py
# Copy to ".env" and fill in real values, then load it before starting the server:
#   set -a && . ./.env && set +a && python3 server.py
#
# (server.py reads plain environment variables; the ".env" file is just a
#  convenient place to keep them. Do NOT commit your real .env.)

# Base resource endpoint from Azure Portal -> your Azure OpenAI resource ->
# "Keys and Endpoint" (do NOT include /openai/deployments/...).
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# KEY 1 or KEY 2 from the same "Keys and Endpoint" page.
AZURE_OPENAI_API_KEY=your-azure-openai-key

# The deployment name you created in Azure AI Foundry / Azure OpenAI Studio
# (this is the deployment name, not necessarily the model name).
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# API version. Use the latest your resource supports.
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Where the server listens.
HOST=0.0.0.0
PORT=8000
